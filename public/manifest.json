{
  "manifest_version": 3,
  "name": "Poker Player Notes",
  "version": "2.0.0",
  "description": "Take notes on poker players at play.pokerlulu.com",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://play.pokerlulu.com/*",
    "http://localhost:3001/*",
    "http://localhost:8080/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://play.pokerlulu.com/*", "http://localhost:8080/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://play.pokerlulu.com/*", "http://localhost:8080/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Poker Player Notes"
  }
}
